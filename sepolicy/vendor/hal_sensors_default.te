# Find the IIO devices under /sys/bus/iio
allow hal_sensors_default sysfs:dir r_dir_perms;

# Use the Cros-EC IIO sensors and their triggers
allow hal_sensors_default iio_device:chr_file r_file_perms;
r_dir_file(hal_sensors_default, sysfs_iio)
allow hal_sensors_default sysfs_iio:file rw_file_perms;

get_prop(hal_sensors_default, vendor_iio_sensors_prop)
