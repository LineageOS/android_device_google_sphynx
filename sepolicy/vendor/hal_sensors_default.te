# Discover the IIO provider, ring, and trigger symlinks under /sys/bus/iio.
allow hal_sensors_default sysfs:dir r_dir_perms;

# Access is limited to the Cros-EC trees labeled sysfs_iio for Sphynx.
allow hal_sensors_default sysfs_iio:dir r_dir_perms;
allow hal_sensors_default sysfs_iio:file rw_file_perms;
allow hal_sensors_default iio_device:chr_file r_file_perms;
