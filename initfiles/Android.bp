prebuilt_etc {
    name: "fstab.dragon",
    vendor: true,
    ramdisk_available: true,
    src: "fstab.dragon",
}

prebuilt_etc {
    name: "init.dragon.rc",
    vendor: true,
    relative_install_path: "init/hw",
    src: "init.dragon.rc",
}

prebuilt_etc {
    name: "init.recovery.dragon.rc",
    src: "init.recovery.dragon.rc",
    sub_dir: "init",
    recovery: true,
}

prebuilt_etc {
    name: "init.loki_foster_e_common.rc",
    vendor: true,
    relative_install_path: "init/hw",
    src: "init.loki_foster_e_common.rc",
}

prebuilt_etc {
    name: "power.dragon.rc",
    device_specific: true,
    src: "power.dragon.rc",
}

cc_prebuilt_binary {
    name: "lkm_loader_target",
    srcs: ["lkm_loader_target.sh"],
    filename: "lkm_loader_target.sh",
    vendor: true,
}
